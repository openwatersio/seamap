#!/usr/bin/env bash
# Publish a built PMTiles to R2.
#
# Uploads an immutable, versioned object (seamap/<version>.pmtiles), then flips
# the `seamap/latest` pointer — a one-line text object naming the current
# version. The Worker at tiles.openwaters.io/seamap reads the pointer to resolve
# which archive to serve, and derives TileJSON from the archive itself, so
# nothing else is published. Atomic for readers: archives are immutable and
# cached forever; only the tiny pointer is overwritten.
#
# rclone reads the R2 remote ("r2") from env, so no config file is needed:
#   RCLONE_CONFIG_R2_TYPE=s3
#   RCLONE_CONFIG_R2_PROVIDER=Cloudflare
#   RCLONE_CONFIG_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   RCLONE_CONFIG_R2_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=...
#
# Config (with defaults):
#   R2_BUCKET=tiles
#   VERSION=<UTC date>
#   PMTILES=data/seamarks.pmtiles
#   UPDATE_LATEST=true    # set false for smoke builds so `latest` isn't flipped
#   POINTER_ONLY=         # set 1 to point `latest` at an already-uploaded
#                         # version (rollback) — no build, no upload
set -euo pipefail
cd "$(dirname "$0")/.."

R2_BUCKET="${R2_BUCKET:-tiles}"
VERSION="${VERSION:-$(date -u +%Y-%m-%d)}"
PMTILES="${PMTILES:-data/seamarks.pmtiles}"
UPDATE_LATEST="${UPDATE_LATEST:-true}"
POINTER_ONLY="${POINTER_ONLY:-}"

key="seamap/${VERSION}.pmtiles"

if [ "$POINTER_ONLY" != "1" ]; then
  [ -f "$PMTILES" ] || { echo "missing $PMTILES — build it first (or set POINTER_ONLY=1)" >&2; exit 1; }
  echo "Uploading $PMTILES -> r2:$R2_BUCKET/$key"
  rclone copyto "$PMTILES" "r2:$R2_BUCKET/$key" \
    --progress --s3-no-check-bucket \
    --header-upload "Cache-Control: public, max-age=31536000, immutable"
fi

if [ "$UPDATE_LATEST" = "true" ]; then
  pointer="$(mktemp)"
  printf '%s\n' "$VERSION" > "$pointer"
  # Short TTL: the Worker holds the pointer for a minute, so a release (or a
  # rollback) is live within about two.
  rclone copyto "$pointer" "r2:$R2_BUCKET/seamap/latest" --s3-no-check-bucket \
    --header-upload "Cache-Control: public, max-age=60"
  rm -f "$pointer"
  echo "Published seamap/${VERSION} -> latest"
else
  echo "Published seamap/${VERSION} (latest unchanged)"
fi
