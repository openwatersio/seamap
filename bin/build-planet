#!/usr/bin/env bash
# Full-planet build, then publish to R2. Runs on a big build box (~128GB RAM, or
# less RAM + fast NVMe via mmap). See bin/publish for the required R2 env vars.
#
# Config (with defaults):
#   OSM_URL   planet PBF to download
#   TMP_DIR   scratch dir (needs ~120GB fast disk)
#   THREADS   defaults to all cores
#   JAVA_OPTS heap; keep modest so the OS can page-cache the mmap'd node map
set -euo pipefail
cd "$(dirname "$0")/.."

OSM_URL="${OSM_URL:-https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf}"
TMP_DIR="${TMP_DIR:-data/tmp}"
THREADS="${THREADS:-$(nproc)}"
# Keep heap modest; planetiler wants most RAM free for the OS to page-cache the
# mmap'd node map. -Xmx16g fits a 32GB box and is plenty even on bigger ones.
export JAVA_OPTS="${JAVA_OPTS:--Xmx16g -XX:+UseParallelGC}"

# Rock/wreck depths come straight from Seascape's live raster tiles; features
# without a depth tag get one sampled from the DEM.
# The default lives in its own variable because bash ends a ${VAR:-...} default
# at the first literal `}` — inlining a {z}/{x}/{y} template silently truncates it.
DEPTH_URL_DEFAULT='https://tiles.openwaters.io/seascape/{z}/{x}/{y}.webp'
DEPTH_URL="${DEPTH_URL:-$DEPTH_URL_DEFAULT}"
case "$DEPTH_URL" in
  *'{z}'*'{x}'*'{y}'*|/*) ;;
  *) echo "DEPTH_URL is not a {z}/{x}/{y} template or a file path: $DEPTH_URL" >&2; exit 1;;
esac

mkdir -p "$TMP_DIR"
bin/run \
  --download --osm-url="$OSM_URL" \
  --depth="$DEPTH_URL" \
  --maxzoom=14 \
  --tmp="$TMP_DIR" \
  --nodemap-type=array --storage=mmap \
  --threads="$THREADS" --download-threads=10 --http-retries=3 \
  --force 2>&1 | tee "$TMP_DIR/build.log"

# Healthy planet builds log zero ERR lines (measured across five production
# runs), so any at all means features were silently lost: planetiler swallows
# per-feature exceptions, and without this gate a bug publishes a planet
# quietly missing everything it touched.
errors=$(grep -c ' ERR ' "$TMP_DIR/build.log" || true)
if [ "$errors" -gt 0 ]; then
  echo "$errors ERR lines in the build log — refusing to publish (see $TMP_DIR/build.log)" >&2
  exit 1
fi

bin/publish
