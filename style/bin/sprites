#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

src=sprites
out=sprites/dist

command -v spreet >/dev/null || {
  echo "spreet not found — run 'mise install' (pinned in mise.toml)" >&2
  exit 1
}

# genicons.py globs *.svg from the working directory and writes gen/ beside them,
# expanding each shape over every colour and pattern combination.
rm -rf "$src/icons/gen" "$out"
(cd "$src/icons" && PYTHONPATH=.. PYTHONDONTWRITEBYTECODE=1 python3 ../genicons.py >/dev/null)

# S-57-keyed icons address ENC attribute codes; our tiles carry OSM tags and no
# layer names them. Dropping them halves the sprite index the browser parses.
# The compass roses are 1024px and unused (upstream drops them too).
rm -rf "$src"/icons/gen/{BCNSHP,BOYSHP,TOPSHP,CATLMK} "$src"/icons/gen/compass-*

# Amenities ashore are badges built from the CC0 Maki/Temaki sets rather than
# chart line art — see bin/poi-badges. Composed into gen/ so the output stays
# out of git, alongside the expanded chart symbols spreet is about to pack.
bin/poi-badges "$src/icons/gen" "$src/poi-icons.json" ../node_modules

# MapLibre tiles fill patterns edge to edge, so the image is the repeat cell:
# cropped to the artwork they read as a solid mass instead of chart hatching.
# Pad the icons the style uses as fill patterns into a 32-unit cell (64px at
# the 2x ratio below). Upstream sidesteps this only because its own style
# doesn't hatch restricted areas.
python3 - "$src/icons/gen" <<'PY'
import re, sys
from pathlib import Path

CELL = 32

# Every fill pattern the style uses: layers/areas.ts `restricted-areas-fill-pattern` plus the
# `unsurveyed` water stipple (full-bleed at cell size, so its pad is a no-op). A test in
# index.test.ts fails if the style grows a fill pattern that is not listed here.
PATTERN_ICONS = ("military", "no-entry", "no-anchor", "unsurveyed")

# fill-pattern cannot scale, so a pattern's on-screen size is fixed by its raster: at overview
# zooms the 32-unit cell is bigger than many of the areas it fills, and the glyph pokes out of
# a corner or never repeats. Each glyph pattern also ships a half-size `-sm` variant — same
# artwork, half the units — for the style to step down to. The stipple stays single-size: it is
# texture, and halving it would read as a different (denser) convention, not a smaller symbol.
SMALL_VARIANTS = ("military", "no-entry", "no-anchor")

gen = Path(sys.argv[1])
for name in PATTERN_ICONS:
    path = gen / f"{name}.svg"
    if not path.exists():
        continue
    svg = path.read_text()
    head = svg[: svg.index(">", svg.index("<svg"))]
    dims = {a: re.search(rf'\b{a}="([\d.]+)"', head) for a in ("width", "height")}
    if not all(dims.values()) or "viewBox" in head:
        continue
    w, h = (float(m.group(1)) for m in dims.values())
    cell = max(CELL, w, h)
    for attr in ("width", "height"):
        head = re.sub(rf'\b{attr}="[\d.]+"', f'{attr}="{cell:g}"', head, count=1)
    box = f'viewBox="{(w - cell) / 2:g} {(h - cell) / 2:g} {cell:g} {cell:g}"'
    path.write_text(head + f" {box}" + svg[svg.index(">", svg.index("<svg")):])
    if name in SMALL_VARIANTS:
        small = head
        for attr, value in (("width", cell / 2), ("height", cell / 2)):
            small = re.sub(rf'\b{attr}="[\d.]+"', f'{attr}="{value:g}"', small, count=1)
        (gen / f"{name}-sm.svg").write_text(
            small + f" {box}" + svg[svg.index(">", svg.index("<svg")):]
        )
PY

# The landmark sources are drawn at their 1.3x display scale; a conspicuous
# landmark draws bolder at 1.6x, expanded here as a convis/ variant of each —
# a size variant, the same way genicons expands colour variants. The style's
# literal convis/ references fail its sprite-sheet test if this list falls out
# of step with layers/labels.ts.
python3 - "$src/icons/gen" <<'PY'
import re, sys
from pathlib import Path

LANDMARKS = (
    "church cairn-lmk chimney column cross-lmk dish_aerial dome flagstaff "
    "flare-stack mast monument obelisk radar_scanner spire statue tower-lmk "
    "windmill windmotor windsock"
).split()
CONVIS = 1.6 / 1.3  # the sources already carry the 1.3x base scale

gen = Path(sys.argv[1])
(gen / "convis").mkdir(exist_ok=True)
for name in LANDMARKS:
    svg = (gen / f"{name}.svg").read_text()
    head_end = svg.index(">", svg.index("<svg"))
    head = svg[:head_end]
    # (?<![-\w]) keeps width= from matching attributes like inkscape:window-width=
    for attr in ("width", "height"):
        value = float(re.search(rf'(?<![-\w]){attr}="([\d.]+)"', head).group(1))
        head = re.sub(
            rf'(?<![-\w]){attr}="[\d.]+"', f'{attr}="{value * CONVIS:g}"', head, count=1
        )
    (gen / "convis" / f"{name}.svg").write_text(head + svg[head_end:])
PY

# Upstream's recipe (vector/makefile): rasterize at 2x/4x, then relabel the
# pixel ratio down one step, so icons draw at twice their source units — the
# scale the style's icon-size values are written against.
mkdir -p "$out"
spreet --recursive --unique --minify-index-file --ratio 2 "$src/icons/gen" "$out/freenauticalchart"
perl -pi -e 's/"pixelRatio":\s*\d+/"pixelRatio":1/g' "$out/freenauticalchart.json"
spreet --recursive --unique --minify-index-file --ratio 4 "$src/icons/gen" "$out/freenauticalchart@2x"
perl -pi -e 's/"pixelRatio":\s*\d+/"pixelRatio":2/g' "$out/freenauticalchart@2x.json"

# The one badge glyph whose licence has conditions, plus the sheet's origin.
cp "$src/LICENSE-MIT-tabler" "$src/PROVENANCE.md" "$out/"

echo "built $(python3 -c 'import json;print(len(json.load(open("'"$out"'/freenauticalchart.json"))))') icons into $out"
