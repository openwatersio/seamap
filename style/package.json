{
  "name": "@openwaters/seamap",
  "version": "0.3.0",
  "description": "MapLibre GL style for Open Waters Seamap – base map, bathymetry, chart symbology",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwatersio/seamap.git",
    "directory": "style"
  },
  "files": [
    "dist",
    "index.ts",
    "layers",
    "sprites/dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./index.ts",
      "default": "./dist/index.js"
    },
    "./sprites/*": "./sprites/dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "sprites": "bin/sprites",
    "prepublishOnly": "npm run sprites",
    "test": "vitest run"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "^25.0.0",
    "@openwaters/seascape": "^0.3.0",
    "@versatiles/style": "^5.13.1"
  },
  "devDependencies": {
    "@iconify-json/maki": "^1.2.5",
    "@iconify-json/pinhead": "^1.2.23",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/temaki": "^1.2.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
